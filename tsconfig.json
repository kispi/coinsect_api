{
  "compilerOptions": {
    "lib": [
      "es5",
      "es6",
      "es2020.string",
      "es2020.promise"
    ],
    "target": "es6",
    "module": "commonjs",
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictPropertyInitialization": false,
    "strictNullChecks": false,
    "moduleResolution": "bundler",
    "noEmitOnError": false,
    "skipLibCheck": true,
    "outDir": "dist-temp",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true
  }
}
